{
  "name": "thought-bubble-studio",
  "version": "1.4.2",
  "private": true,
  "description": "Offline cybersecurity photo experience",
  "author": "Thought Bubble Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "record": "npm run build && electron . --recording",
    "test": "node --test \"tests/*.test.cjs\"",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "dist:win:all": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "verify:ui": "node scripts/verify-ui.cjs",
    "verify:desktop": "node scripts/verify-desktop.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:gpu": "node scripts/verify-bubble-gpu.cjs",
    "benchmark:tracking": "node scripts/benchmark-tracking.cjs",
    "predev": "node scripts/prepare-vision.cjs",
    "prebuild": "node scripts/prepare-vision.cjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.thoughtbubble.studio",
    "productName": "Thought Bubble Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.photography",
      "extendInfo": {
        "NSCameraUsageDescription": "Capture your cybersecurity photo at the Thought Bubble station."
      },
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "target": "nsis",
      "signAndEditExecutable": false,
      "extraFiles": [
        {
          "from": "TEST-WINDOWS.txt",
          "to": "TEST-WINDOWS.txt"
        },
        {
          "from": "build/printer-test-6x4.jpg",
          "to": "printer-test-6x4.jpg"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
